{
  "$schema": "https://v2-9-6.turborepo.dev/schema.json",
  "globalDependencies": [
    "**/.env.*local"
  ],
  "tasks": {
    "build": {
      "dependsOn": [
        "^build"
      ],
      "outputs": [
        ".next/**",
        "!.next/cache/**",
        "out/**"
      ]
    },
    "lint": {
      "dependsOn": [
        "^lint"
      ]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "transit": {
      "dependsOn": ["^transit"]
    },
    "test": {
      "dependsOn": ["^transit"],
      "outputs": ["coverage/**"],
      "inputs": ["$TURBO_DEFAULT$", "!e2e/**", "!playwright.config.ts"]
    },
    "test:e2e": {
      "cache": false,
      "env": ["CI"]
    }
  }
}
