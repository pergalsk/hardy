{
  "name": "hardy",
  "private": true,
  "scripts": {
    "build": "turbo build",
    "dev": "turbo dev",
    "lint": "turbo lint",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "test": "turbo test",
    "test:e2e": "turbo test:e2e",
    "test:coverage": "turbo test -- --coverage",
    "coverage:summary": "node scripts/coverage-summary.mjs"
  },
  "devDependencies": {
    "@iconify-json/material-symbols": "^1.1.89",
    "@iconify/tailwind4": "^1.2.3",
    "@repo/eslint-config": "*",
    "@repo/typescript-config": "*",
    "@tailwindcss/postcss": "^4.3.3",
    "@vitest/coverage-v8": "^5.1.0",
    "postcss": "^8.4.38",
    "prettier": "^3.3.2",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4.3.3",
    "turbo": "^2.11.11",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "npm@10.2.3",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "dependencies": {
    "@uiw/react-json-view": "^2.0.0-alpha.24",
    "nanoid": "^6.0.2",
    "zustand": "^5.0.12"
  }
}
